FROM golang:1.25.5-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/misty-server .

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/misty-server /usr/local/bin/misty-server
RUN useradd --system --uid 10001 --create-home misty \
    && mkdir -p /var/lib/misty-demo/library \
    && chown -R misty:misty /var/lib/misty-demo
USER misty
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/misty-server"]
