VITE_API_BASE=/api
# Development server only. Browser requests stay same-origin while Vite
# forwards /api to the local Go server, preserving HttpOnly session cookies.
VITE_API_PROXY_TARGET=http://localhost:8081
# Optional. When unset, beta CTAs use the working /waitlist fallback.
# VITE_DISCORD_INVITE_URL=https://discord.gg/your-permanent-invite
