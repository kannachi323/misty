{
  "name": "@misty/journal-collab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "npm run build && MISTY_RUNTIME_TEST=1 vitest run test/runtime-lifecycle.test.ts",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "lib0": "^0.2.117",
    "partyserver": "0.5.8",
    "y-partyserver": "2.2.0",
    "y-protocols": "1.0.6",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260625.1",
    "miniflare": "4.20260625.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.105.0"
  }
}
