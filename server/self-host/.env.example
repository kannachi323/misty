# Use release-provided immutable image digests. Never use latest in production.
MISTY_API_IMAGE=ghcr.io/example/misty-api@sha256:replace-with-release-digest
MISTY_COLLAB_IMAGE=ghcr.io/example/misty-collab@sha256:replace-with-release-digest

DB_NAME=misty
DB_USER=misty_app
DB_PASSWORD=replace-with-random-password
DB_MIGRATION_USER=misty_migrations
DB_MIGRATION_PASSWORD=replace-with-a-different-random-password

MISTY_INSTANCE_NAME=Home Studio
MISTY_PUBLIC_API_URL=https://misty.example.com/api
MISTY_COLLAB_PUBLIC_URL=https://misty.example.com
MISTY_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
MISTY_LIBRARY_BACKEND=filesystem
MISTY_COLLAB_INTERNAL_SECRET=replace-with-at-least-32-random-characters
PARTYKIT_HOST=misty.example.com

# Base64 PKCS#8 Ed25519 private key for the API, and its raw 32-byte public key.
JOURNAL_COLLAB_TICKET_PRIVATE_KEY=replace-with-base64-pkcs8-private-key
JOURNAL_COLLAB_TICKET_PUBLIC_KEY=replace-with-base64-raw-public-key
JOURNAL_COLLAB_CONTROL_SECRET=replace-with-base64-32-byte-secret
JOURNAL_COLLAB_PROJECTION_SECRET=replace-with-base64-32-byte-secret
JOURNAL_COLLAB_ROOM_SALT=replace-with-base64-32-byte-secret
SPACE_LINK_ENCRYPTION_KEY=replace-with-base64-32-byte-secret

# For S3-compatible storage, set MISTY_LIBRARY_BACKEND=s3 and fill these.
MISTY_S3_ENDPOINT=https://s3.example.com
MISTY_S3_BUCKET=misty-library
MISTY_S3_REGION=us-east-1
MISTY_S3_ACCESS_KEY_ID=
MISTY_S3_SECRET_ACCESS_KEY=
MISTY_S3_FORCE_PATH_STYLE=true
