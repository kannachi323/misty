# Compose selects the exact tested image. Pin a registry digest in production.
MISTY_API_IMAGE=registry.example.com/misty-server@sha256:replace-me
MISTY_HOST_PORT=8081

# Runtime identity and public routing.
MISTY_ENVIRONMENT=production
PORT=8080
MISTY_PUBLIC_API_URL=https://mistysys.com/api
MISTY_OPERATOR_USER_ID=replace-with-mattdev727-immutable-user-id
# Browser app and API are deliberately separate origins. Keep this allow-list
# explicit; credentialed browser requests must never use a wildcard origin.
MISTY_ALLOWED_ORIGINS=https://mistysys.com,https://app.mistysys.com
MISTY_WEBSITE_URL=https://app.mistysys.com
AUTH_HANDOFF_START_URL=https://mistysys.com/api/auth/handoff/start
PASSWORD_RESET_URL=https://app.mistysys.com/reset
PASSWORD_RESET_START_URL=https://mistysys.com/api/auth/reset/start
TRUST_PROXY_HEADERS=true

# PostgreSQL. The API receives only DB_USER and DB_PASSWORD.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=misty
DB_USER=misty_app
DB_PASSWORD=replace-with-a-long-random-application-password
DB_MIGRATION_USER=misty_owner
DB_MIGRATION_PASSWORD=replace-with-a-different-long-random-owner-password

# Cloudflare R2.
R2_ENDPOINT=https://replace-me.r2.cloudflarestorage.com
R2_BUCKET=misty
R2_ACCESS_KEY=replace-me
R2_SECRET_KEY=replace-me

# Journal collaboration Worker. Generate the shared secrets with misty.
PARTYKIT_HOST=misty-journal-collab.mistysys.workers.dev
JOURNAL_COLLAB_TICKET_PRIVATE_KEY=replace-with-base64-pkcs8-ed25519-private-key
JOURNAL_COLLAB_CONTROL_SECRET=replace-with-at-least-32-base64-random-bytes
JOURNAL_COLLAB_PROJECTION_SECRET=replace-with-at-least-32-base64-random-bytes
JOURNAL_COLLAB_ROOM_SALT=replace-with-at-least-32-base64-random-bytes

# Signed self-host entitlement proofs. The key ID must match a public key
# bundled into eligible self-hosted server releases.
MISTY_SELF_HOST_ENTITLEMENT_PRIVATE_KEY=replace-with-base64-pkcs8-ed25519-private-key
MISTY_SELF_HOST_ENTITLEMENT_KEY_ID=misty-2026-01
MISTY_SELF_HOST_ENTITLEMENT_SUBJECT_SECRET=replace-with-at-least-32-base64-random-bytes

# Connected Devices. This is independent of Agent device jobs and stays off
# until the desktop and managed relay are deployed together.
MISTY_CONNECTED_DEVICES_ENABLED=false
MISTY_DEVICE_TICKET_PRIVATE_KEY=replace-with-base64-pkcs8-ed25519-private-key
MISTY_DEVICE_PAIRING_PEPPER=replace-with-at-least-32-base64-random-bytes
# Optional comma-separated base64 raw Ed25519 public keys retained during key rotation.
MISTY_DEVICE_TICKET_PREVIOUS_PUBLIC_KEYS=

# Application security.
SPACE_LINK_ENCRYPTION_KEY=replace-me

# Stripe live mode. Production does not run stripe listen.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_WEBHOOK_PATH=/api/stripe/webhook
STRIPE_PRICE_PRO_MONTHLY=price_replace_me_1
STRIPE_PRICE_PRO_YEARLY=price_replace_me_2
STRIPE_PRICE_MAX_MONTHLY=price_replace_me_3
STRIPE_PRICE_MAX_YEARLY=price_replace_me_4
STRIPE_CHECKOUT_SUCCESS_URL=https://mistysys.com/replace-me
STRIPE_CHECKOUT_CANCEL_URL=https://mistysys.com/replace-me
STRIPE_PORTAL_RETURN_URL=https://mistysys.com/replace-me
