{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "title": "API request rate",
      "type": "timeseries",
      "targets": [{"expr": "sum by (status) (rate(misty_http_requests_total[5m]))", "legendFormat": "{{status}}"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "title": "API p95 latency",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(misty_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "title": "Database connections",
      "type": "timeseries",
      "targets": [
        {"expr": "misty_db_connections_in_use", "legendFormat": "in use"},
        {"expr": "misty_db_connections_open", "legendFormat": "open"},
        {"expr": "misty_db_connections_max", "legendFormat": "maximum"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "title": "Journal control backlog",
      "type": "timeseries",
      "targets": [{"expr": "misty_note_control_backlog", "legendFormat": "due controls"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
    },
    {
      "title": "Realtime connections",
      "type": "timeseries",
      "targets": [
        {"expr": "misty_realtime_connections", "legendFormat": "connections"},
        {"expr": "misty_realtime_viewed_spaces", "legendFormat": "viewed Spaces"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
    },
    {
      "title": "Library and upload backlogs",
      "type": "timeseries",
      "targets": [
        {"expr": "misty_upload_reservations_active", "legendFormat": "upload reservations"},
        {"expr": "misty_library_jobs_pending_ai", "legendFormat": "AI"},
        {"expr": "misty_library_jobs_pending_rendition", "legendFormat": "renditions"},
        {"expr": "misty_library_jobs_pending_people", "legendFormat": "people"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["misty", "public-beta"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Misty public beta",
  "uid": "misty-public-beta",
  "version": 1
}
