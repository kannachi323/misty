{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misty-note-collab",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],

  // The account is not a secret; it appears in every Cloudflare dashboard URL.
  // Move it to a CLOUDFLARE_ACCOUNT_ID environment variable if this repository
  // ever becomes public and you would rather not publish it.
  "account_id": "d7f44352f4bc93b83944cdb10b0abd6e",

  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "NOTE_ROOM", "class_name": "NoteRoom" }]
  },

  // SQLite-backed Durable Objects. This is deliberate: the key-value backed
  // classes are the older form, and SQLite storage is what y-partyserver
  // expects for document persistence.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteRoom"] }],

  "vars": {
    // Non-secret configuration. Every secret is set with `wrangler secret put`
    // and never appears in this file.
    "MISTY_INTERNAL_API_BASE": "http://localhost:8080",
    "NOTE_COLLAB_ISSUER": "misty-api",
    "NOTE_COLLAB_AUDIENCE": "misty-note-collab"
  }
}
