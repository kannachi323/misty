FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json vitest.config.ts wrangler.jsonc ./
COPY src ./src
COPY scripts ./scripts
COPY test ./test
COPY --chmod=0555 docker/cloudflare-init.sh /usr/local/bin/misty-cloudflare-init
COPY --chmod=0555 docker/cloudflare-deploy.sh /usr/local/bin/misty-cloudflare-deploy

CMD ["npm", "run", "build"]
