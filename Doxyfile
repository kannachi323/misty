PROJECT_NAME           = "Misty"
PROJECT_BRIEF          = "Desktop file explorer and sync client"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

INPUT                  = src
FILE_PATTERNS          = *.h *.cpp *.mm
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */vendor/* */build/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = api/html
GENERATE_LATEX         = NO
GENERATE_XML           = NO

FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
SORT_MEMBER_DOCS       = YES
CASE_SENSE_NAMES       = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = YES

HAVE_DOT               = NO
QUIET                  = NO
