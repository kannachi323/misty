{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [{ "name": "workflow" }]
  },
  "include": ["src", "workflows", "nitro.config.ts", "test"]
}
