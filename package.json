{
  "name": "misty",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app",
    "extensions",
    "website"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build:website && npm run build:app",
    "build:extensions": "npm run build --workspace=@misty/plugins",
    "validate:extensions": "npm run validate --workspace=@misty/plugins",
    "check:web": "npm run typecheck && npm run lint && npm run test && npm run build:web",
    "dev:app": "npm run dev:web --workspace=@misty/app",
    "build:app": "npm run build:web --workspace=@misty/app",
    "test:app": "npm run test --workspace=@misty/app",
    "dev:desktop": "npm run tauri --workspace=@misty/app -- dev",
    "build:desktop": "npm run tauri --workspace=@misty/app -- build",
    "dev:website": "npm run dev --workspace=@misty/website",
    "build:website": "npm run build --workspace=@misty/website",
    "test:website": "npm run test --workspace=@misty/website"
  }
}
