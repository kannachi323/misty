  "type": "module",
  "scripts": {
    "dev": "npm run dev:desktop",
    "dev:desktop": "node scripts/prepare-desktop-apps.mjs && vite --mode desktop",
    "dev:mobile": "vite --mode mobile --host 0.0.0.0 --port 5173",
    "dev:android": "vite --mode android --host 0.0.0.0",
    "dev:web": "vite --mode web --host 0.0.0.0 --port 5173",
    "build": "npm run build:desktop",
    "build:desktop": "tsc && vite build --mode desktop",
    "build:mobile": "tsc && vite build --mode mobile",
    "build:android": "tsc && vite build --mode android",
    "build:web": "tsc && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --mode web",
    "build:official-apps": "node scripts/build-official-app-packages.mjs",
    "deploy:web:dev": "npm run build:web && wrangler deploy --env dev",
    "preview": "vite preview --mode desktop",
    "preview:mobile": "vite preview --mode mobile",
    "preview:web": "vite preview --mode web",
    "icons:ios": "node scripts/generate-ios-app-icons.mjs",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:sdk-refresh": "node --test scripts/vite-public-sdk.test.mjs",
    "audit:production": "audit-ci --config audit-ci.json",
    "check": "npm run check:format && npm run typecheck && npm run lint && npm run test && npm run test:sdk-refresh && npm run audit:production",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check:format": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "sdk:sync": "node scripts/sync-public-sdk.mjs",
    "beta:prepare": "node scripts/release/beta.mjs prepare",
    "beta:promote": "node scripts/release/beta.mjs promote",
    "beta:keys": "node scripts/release/setup-keys.mjs"
  },
