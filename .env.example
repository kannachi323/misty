# Server-side PostHog capture uses the same public project token as the app.
POSTHOG_PROJECT_TOKEN=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com
MISTY_ENVIRONMENT=production
MISTY_RELEASE_CHANNEL=production
MISTY_SERVER_VERSION=0.1.0
# Exact comma-separated web origins allowed to call the API. Wildcards are
# ignored. Tauri and local Vite development origins are built in.
MISTY_ALLOWED_ORIGINS=https://misty.example

# Runtime requests should use the restricted DB_USER role. Schema migrations
# require the table-owning role and can be configured separately for goose.sh.
DB_HOST=postgres
DB_PORT=5432
DB_USER=misty_app
DB_PASSWORD=
DB_NAME=misty_server
DB_MIGRATION_USER=misty
DB_MIGRATION_PASSWORD=

# Misty Agents Beta rollout gates (opt in independently by phase).
MISTY_DEVICE_JOBS_ENABLED=false
MISTY_FOLDER_AGENTS_ENABLED=false
MISTY_AGENT_DOCUMENTS_ENABLED=false
# Agent attachments and the Space Library share one private R2 bucket. Apply
# the two-day lifecycle rule only to the agents/ prefix; library/ is permanent.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=misty-server
R2_ACCESS_KEY=
R2_SECRET_KEY=
# DOCUMENT_SIGNING_KEY=replace_with_32_or_more_random_bytes
# Generate a dedicated RSA key-encryption key, keep the private key only in
# deployment secrets, and base64-encode its PEM without line wrapping:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | base64
# DOCUMENT_KEY_ID=2026-07
# DOCUMENT_PRIVATE_KEY_B64=
# During rotation, retain old keys for at least 24 hours as a JSON object:
# DOCUMENT_PREVIOUS_KEYS_JSON={"2026-06":"BASE64_PEM"}
# Vercel AI Gateway. AI_GATEWAY_API_KEY is the only required AI setting for an
# externally hosted server. Smart Library sends small preview batches through
# this existing server; no Blob or Queue deployment is required.
AI_GATEWAY_API_KEY=replace_me
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
SMART_LIBRARY_PRICE_MINOR_PER_IMAGE=
SMART_LIBRARY_PRICE_CURRENCY=USD
SMART_LIBRARY_EMERGENCY_DISABLE=false
# MISTY_AI_LOW_MODEL=google/gemini-2.5-flash-lite
# MISTY_AI_MED_MODEL=google/gemini-2.5-flash
# MISTY_AI_HIGH_MODEL=google/gemini-3.5-flash

# Stripe Billing: create recurring Pro/Max prices and one-time credit pack prices.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CHECKOUT_SUCCESS_URL=https://misty.example/account?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://misty.example/account?checkout=canceled
STRIPE_PORTAL_RETURN_URL=https://misty.example/account
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_YEARLY=price_replace_me
STRIPE_PRICE_MAX_MONTHLY=price_replace_me
STRIPE_PRICE_MAX_YEARLY=price_replace_me
STRIPE_PRICE_CREDITS_1500=price_replace_me
STRIPE_PRICE_CREDITS_3500=price_replace_me
# 32-byte, base64, or hex key used to encrypt opaque Google Drive targets.
# Required in production. Rotate by introducing a new key version before removal.
SPACE_LINK_ENCRYPTION_KEY=

# Unified Space Library is enabled by default. AI/OCR, media processing, and
# People processing activate when their dependencies below are configured.
# Optional private processor for automatic People & Pets detection. Image bytes
# are sent only after the Space owner opts in. The JSON response contains a
# bounded list of kind, confidence, bounds, and embedding detections.
VISION_PROCESSOR_URL=
VISION_PROCESSOR_TOKEN=
# Install ffmpeg and ffprobe on the server PATH to enable previews and edits.
