# Server-side PostHog capture uses the same public project token as the app.
POSTHOG_PROJECT_TOKEN=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com
MISTY_ENVIRONMENT=production
MISTY_RELEASE_CHANNEL=production
MISTY_SERVER_VERSION=0.1.0
# Exact comma-separated web origins allowed to call the API. Wildcards are
# ignored. Tauri and local Vite development origins are built in.
MISTY_ALLOWED_ORIGINS=https://misty.example

# Misty Agents Beta rollout gates (opt in independently by phase).
MISTY_DEVICE_JOBS_ENABLED=false
MISTY_FOLDER_AGENTS_ENABLED=false
MISTY_AGENT_DOCUMENTS_ENABLED=false
# Agent document attachments are encrypted on the device and retained for 24
# hours. Cloudflare R2 is S3-compatible. Use a dedicated PRIVATE bucket: turn
# off its r2.dev/custom public domain and restrict the token to this bucket.
# Configure an R2 lifecycle rule deleting agents/ objects after 2 days as a
# backstop; Misty's retention worker performs the exact 24-hour deletion.
# DOCUMENT_STORE=r2
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=misty-agent-attachments
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PRIVATE=true
# S3_LIFECYCLE_DAYS=2
# DOCUMENT_SIGNING_KEY=replace_with_32_or_more_random_bytes
# Generate a dedicated RSA key-encryption key, keep the private key only in
# deployment secrets, and base64-encode its PEM without line wrapping:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | base64
# DOCUMENT_KEY_ID=2026-07
# DOCUMENT_PRIVATE_KEY_B64=
# During rotation, retain old keys for at least 24 hours as a JSON object:
# DOCUMENT_PREVIOUS_KEYS_JSON={"2026-06":"BASE64_PEM"}
# Generic S3-compatible deployments can use DOCUMENT_STORE=s3 and set
# S3_FORCE_PATH_STYLE=true when their provider requires it.
# DOCUMENT_STORE=memory is allowed only outside production.
# Vercel AI Gateway. AI_GATEWAY_API_KEY is the only required AI setting for an
# externally hosted server. Smart Library sends small preview batches through
# this existing server; no Blob or Queue deployment is required.
AI_GATEWAY_API_KEY=replace_me
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
SMART_LIBRARY_PRICE_MINOR_PER_IMAGE=
SMART_LIBRARY_PRICE_CURRENCY=USD
SMART_LIBRARY_EMERGENCY_DISABLE=false
# MISTY_AI_LOW_MODEL=google/gemini-2.5-flash-lite
# MISTY_AI_MED_MODEL=google/gemini-2.5-flash
# MISTY_AI_HIGH_MODEL=google/gemini-3.5-flash

# Stripe Billing: create recurring Pro/Max prices and one-time credit pack prices.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CHECKOUT_SUCCESS_URL=https://misty.example/account?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://misty.example/account?checkout=canceled
STRIPE_PORTAL_RETURN_URL=https://misty.example/account
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_YEARLY=price_replace_me
STRIPE_PRICE_MAX_MONTHLY=price_replace_me
STRIPE_PRICE_MAX_YEARLY=price_replace_me
STRIPE_PRICE_CREDITS_1500=price_replace_me
STRIPE_PRICE_CREDITS_3500=price_replace_me
# 32-byte, base64, or hex key used to encrypt opaque Google Drive targets.
# Required in production. Rotate by introducing a new key version before removal.
SPACE_LINK_ENCRYPTION_KEY=

# Unified Space Library rollout gates. Keep derived subsystems disabled until
# their workers and policies are separately approved.
MISTY_LIBRARY_ENABLED=false
MISTY_LIBRARY_UPLOADS_ENABLED=false
MISTY_LIBRARY_ATTACHMENTS_ENABLED=false
MISTY_LIBRARY_IMPORTS_ENABLED=false
MISTY_LIBRARY_PREVIEWS_ENABLED=false
MISTY_LIBRARY_OCR_ENABLED=false
MISTY_LIBRARY_AI_ENABLED=false
MISTY_LIBRARY_PEOPLE_ENABLED=false
MISTY_LIBRARY_LOCATIONS_ENABLED=false
MISTY_LIBRARY_EDITING_ENABLED=false
MISTY_LIBRARY_DUPLICATES_ENABLED=false
MISTY_LIBRARY_EXPORTS_ENABLED=false
MISTY_LIBRARY_GROUPS_ENABLED=false
# Optional private processor for automatic People & Pets detection. Image bytes
# are sent only after the Space owner opts in. The JSON response contains a
# bounded list of kind, confidence, bounds, and embedding detections.
LIBRARY_PEOPLE_PROCESSOR_URL=
LIBRARY_PEOPLE_PROCESSOR_TOKEN=
# Absolute path to the sandboxed ffmpeg worker used for durable image and
# video edit renditions. Development auto-discovers ffmpeg from PATH; an
# explicit path is required when editing is enabled in production.
LIBRARY_MEDIA_PROCESSOR_BIN=
# Production must use a separate permanent private bucket, never the temporary
# Agent attachment bucket. Confirm no short-expiry lifecycle rule applies.
# LIBRARY_STORE=r2
# LIBRARY_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# LIBRARY_S3_REGION=auto
# LIBRARY_S3_BUCKET=misty-space-library
# LIBRARY_S3_ACCESS_KEY=
# LIBRARY_S3_SECRET_KEY=
# LIBRARY_S3_PRIVATE=true
# LIBRARY_S3_PERMANENT=true
# LIBRARY_MAX_FILE_BYTES=262144000
# Required when uploads are enabled in production. Prefer a private Unix socket
# or isolated scanner service reachable only by the Misty server.
# LIBRARY_CLAMAV_ADDRESS=unix:/run/clamav/clamd.sock
# Persistent development-only alternative:
# LIBRARY_STORE=local
# LIBRARY_LOCAL_DIR=.local/library
