# Public API origin/path used for OAuth callback URLs.
MISTY_PUBLIC_API_URL=https://api.mistysys.com/api

# Misty-managed cloud OAuth applications. Users may optionally supply their
# own client ID and secret when starting a connection.
MISTY_GOOGLE_DRIVE_CLIENT_ID=
MISTY_GOOGLE_DRIVE_CLIENT_SECRET=
MISTY_DROPBOX_CLIENT_ID=
MISTY_DROPBOX_CLIENT_SECRET=
MISTY_ONEDRIVE_CLIENT_ID=
MISTY_ONEDRIVE_CLIENT_SECRET=

# Existing provider-vault encryption key. Required in production.
SPACE_LINK_ENCRYPTION_KEY=
