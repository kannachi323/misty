# Copy this file to .env and fill in only the sections you use.
# Keep real credentials in .env; never put secrets in this example file.

# Optional workspace discovery. Defaults to ~/misty-org or the path saved by
# `misty-cli configure`.
MISTY_ORG_ROOT=

# Optional desktop development overrides.
# MISTY_DESKTOP_DEV_PORT=5173
# MISTY_DESKTOP_INITIAL_ROUTE=/

# Required for every desktop release.
# The updater private key and its password are secrets.
TAURI_UPDATER_PUBLIC_KEY=
TAURI_UPDATER_ENDPOINT=
TAURI_CSP_CONNECT_SOURCES=
TAURI_CSP_IMAGE_SOURCES=
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Required when building the macOS release.
# APPLE_SIGNING_IDENTITY must exactly match a Developer ID Application identity
# reported by `security find-identity -v -p codesigning`.
# MISTY_NOTARY_KEYCHAIN_PROFILE is the profile name previously stored with
# `xcrun notarytool store-credentials`.
APPLE_SIGNING_IDENTITY=
MISTY_NOTARY_KEYCHAIN_PROFILE=

# Optional Windows Authenticode signing. Leave both empty for an unsigned build.
WINDOWS_CERTIFICATE_THUMBPRINT=
WINDOWS_TIMESTAMP_URL=

# Required only by `misty-cli server r2 configure-cors`.
R2_BUCKET=
MISTY_R2_ALLOWED_ORIGINS=

# Optional overrides for production Worker deployment. The CLI otherwise reads
# these from misty-server/.env.prod.
CLOUDFLARE_API_TOKEN=
MISTY_CLOUDFLARE_WORKER_NAME=
