# Environment identity and public endpoints
MISTY_ENVIRONMENT=development
MISTY_RELEASE_CHANNEL=beta
MISTY_SERVER_VERSION=dev
PORT=8081
MISTY_PUBLIC_API_URL=http://localhost:8081/api
MISTY_ALLOWED_ORIGINS=http://localhost:5173
PASSWORD_RESET_START_URL=http://localhost:8081/auth/reset/start
PASSWORD_RESET_URL=http://localhost:5173/#/reset
MISTY_INVITATION_URL_BASE=http://localhost:5173/#/invite

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Private R2 storage. All four values are required in production.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Exact comma-separated browser/Tauri origins used by the one-time CORS setup
# script. Wildcards are rejected.
MISTY_R2_ALLOWED_ORIGINS=https://app.example.com,tauri://localhost,http://tauri.localhost
MISTY_R2_UPLOAD_URL_TTL=15m
MISTY_R2_DOWNLOAD_URL_TTL=15m

# Journal collaboration API configuration
PARTYKIT_HOST=
JOURNAL_COLLAB_TICKET_PRIVATE_KEY=
JOURNAL_COLLAB_CONTROL_SECRET=
JOURNAL_COLLAB_PROJECTION_SECRET=
JOURNAL_COLLAB_ROOM_SALT=
# Temporary dual-read values used only during a no-downtime rotation.
JOURNAL_COLLAB_PROJECTION_SECRET_PREVIOUS=

# Encryption and internal monitoring
SPACE_LINK_ENCRYPTION_KEY=
MISTY_METRICS_TOKEN=
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=

# Transactional email
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Misty
MAILJET_API_BASE_URL=https://api.mailjet.com
WAITLIST_NOTIFY_EMAIL=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_PATH=/stripe/webhook
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# Containerized development orchestration
# Create a scoped Cloudflare token with Workers Scripts:Edit. Wrangler's
# browser login on the host is not available inside the deployment container.
CLOUDFLARE_API_TOKEN=
MISTY_CLOUDFLARE_WORKER_NAME=misty-journal-collab-dev
MISTY_CLOUDFLARE_WORKER_HOST=misty-journal-collab-dev.mistysys.workers.dev

# Misty-managed cloud storage OAuth. A user can alternatively supply their
# own OAuth client when connecting an account.
MISTY_GOOGLE_DRIVE_CLIENT_ID=
MISTY_GOOGLE_DRIVE_CLIENT_SECRET=
MISTY_DROPBOX_CLIENT_ID=
MISTY_DROPBOX_CLIENT_SECRET=
MISTY_ONEDRIVE_CLIENT_ID=
MISTY_ONEDRIVE_CLIENT_SECRET=

# Space integration OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=
NOTION_WEBHOOK_LOG_VERIFICATION_TOKEN=false

# Hosted AI and Smart Library
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_EMBEDDING_BASE_URL=
MISTY_AI_LOW_MODEL=
MISTY_AI_MED_MODEL=
MISTY_AI_HIGH_MODEL=
MISTY_AI_MAX_CALLS_PER_MINUTE=90
MISTY_AI_MAX_CALLS_PER_HOUR=1500
MISTY_AI_MAX_CALLS_PER_DAY=10000
MISTY_AI_MAX_CONCURRENT=8
MISTY_AI_MAX_TOKENS_PER_HOUR=2000000
MISTY_AI_MAX_TOKENS_PER_DAY=20000000
SMART_LIBRARY_PRIMARY_MODEL=
SMART_LIBRARY_FALLBACK_MODEL=
SMART_LIBRARY_EMBEDDING_MODEL=
SMART_LIBRARY_SEARCH_DAILY_LIMIT=
SMART_LIBRARY_EMERGENCY_DISABLE=false
SMART_LIBRARY_SEARCH_EMERGENCY_DISABLE=false
MEDIA_SEARCH_TRANSCRIPTION_MODEL=
MEDIA_SEARCH_TRANSCRIPTION_FALLBACK_MODEL=
MEDIA_SEARCH_EMERGENCY_DISABLE=false
MISTY_AGENT_DOCUMENTS_ENABLED=false

# Optional AI providers used by non-hosted/evaluation paths
MISTY_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_AUTH_MODE=
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=

# Optional telemetry and processing services
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
VISION_PROCESSOR_URL=
VISION_PROCESSOR_TOKEN=

# Safety ceilings and feature gates
MISTY_EGRESS_MAX_BYTES_PER_IDENTITY_DAY=26843545600
MISTY_EGRESS_MAX_BYTES_PER_DAY=214748364800
MISTY_LIBRARY_MAX_FILE_BYTES=
MISTY_NOTE_ATTACHMENT_MAX_FILE_BYTES=
MISTY_DRAWING_ASSET_MAX_FILE_BYTES=
MISTY_CHAT_ATTACHMENT_MAX_FILE_BYTES=
MISTY_DEVICE_JOBS_ENABLED=false
