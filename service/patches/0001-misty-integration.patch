+func (f *Fs) mistyPublicLinksCommand(ctx context.Context, arg []string, opt map[string]string) (any, error) {
+	action := strings.TrimSpace(opt["action"])
+	if action == "" {
+		action = "list"
+	}
+	remote := strings.TrimSpace(opt["remote"])
+	if remote == "" && len(arg) > 0 {
+		remote = arg[0]
+	}
+	if remote == "" && action != "list" {
+		return nil, errors.New("remote path is required")
+	}
+	id := strings.TrimSpace(opt["target_id"])
+	if id == "" && remote != "" {
+		var err error
+		id, err = f.mistyPublicLinkID(ctx, remote)
+		if err != nil {
+			return nil, err
+		}
+	}
+	switch action {
+	case "list":
+		if remote == "" {
+			links, err := f.mistyListAllPublicLinks(ctx)
+			if err != nil {
+				return nil, err
+			}
+			return map[string]any{"supported": true, "provider": "drive", "links": links}, nil
+		}
+		links, err := f.mistyListPublicLinks(ctx, id, remote)
+		if err != nil {
+			return nil, err
+		}
+		return map[string]any{"supported": true, "provider": "drive", "links": links}, nil
+	case "create":
+		permission := &drive.Permission{
+			AllowFileDiscovery: false,
+			Role:               "reader",
+			Type:               "anyone",
+		}
+		err := f.pacer.Call(func() (bool, error) {
+			created, err := f.svc.Permissions.Create(id, permission).
+				Fields("id").
+				SupportsAllDrives(true).
+				EnforceExpansiveAccess(f.opt.EnforceExpansiveAccess).
+				Context(ctx).Do()
+			if created != nil {
+				permission.Id = created.Id
+			}
+			return f.shouldRetry(ctx, err)
+		})
+		if err != nil {
+			return nil, err
+		}
+		url := fmt.Sprintf("https://drive.google.com/open?id=%s", id)
+		return map[string]any{
+			"supported": true,
+			"provider":  "drive",
+			"link": map[string]any{
+				"id":         permission.Id,
+				"url":        url,
+				"provider":   "drive",
+				"target_id":  id,
+				"path":       "/" + strings.TrimPrefix(remote, "/"),
+				"role":       "reader",
+				"scope":      "public",
+				"kind":       "link",
+				"can_revoke": true,
+			},
+			"message": "Public link created.",
+		}, nil
+	case "revoke":
+		permissionID := strings.TrimSpace(opt["id"])
+		if permissionID == "" && len(arg) > 1 {
+			permissionID = arg[1]
+		}
+		if permissionID == "" {
+			return nil, errors.New("permission id is required")
+		}
+		err := f.pacer.Call(func() (bool, error) {
+			err := f.svc.Permissions.Delete(id, permissionID).
+				SupportsAllDrives(true).
+				Context(ctx).Do()
+			return f.shouldRetry(ctx, err)
+		})
+		if err != nil {
+			return nil, err
+		}
+		return map[string]any{"supported": true, "provider": "drive", "message": "Public link revoked."}, nil
+	default:
+		return nil, fmt.Errorf("unknown public link action %q", action)
+	}
+}
+
+func (f *Fs) mistyPublicLinkID(ctx context.Context, remote string) (string, error) {
+	id, err := f.dirCache.FindDir(ctx, remote, false)
+	if err == nil {
+		return shortcutID(id), nil
+	}
+	o, err := f.NewObject(ctx, remote)
+	if err != nil {
+		return "", err
+	}
+	return shortcutID(o.(fs.IDer).ID()), nil
+}
+
+func (f *Fs) mistyListPublicLinks(ctx context.Context, id, remote string) ([]map[string]any, error) {
+	var permissions []*drive.Permission
+	err := f.pacer.Call(func() (bool, error) {
+		result, err := f.svc.Permissions.List(id).
+			Fields("permissions(id,type,role,allowFileDiscovery,expirationTime,emailAddress,displayName,domain)").
+			SupportsAllDrives(true).
+			Context(ctx).Do()
+		if result != nil {
+			permissions = result.Permissions
+		}
+		return f.shouldRetry(ctx, err)
+	})
+	if err != nil {
+		if isGoogleError(err, "insufficientFilePermissions") {
+			return []map[string]any{}, nil
+		}
+		return nil, err
+	}
+	links := make([]map[string]any, 0, len(permissions))
+	for _, permission := range permissions {
+		if permission == nil || permission.Id == "" || permission.Type != "anyone" {
+			continue
+		}
+		url := fmt.Sprintf("https://drive.google.com/open?id=%s", id)
+		link := map[string]any{
+			"id":         permission.Id,
+			"url":        url,
+			"provider":   "drive",
+			"target_id":  id,
+			"path":       "/" + strings.TrimPrefix(remote, "/"),
+			"role":       permission.Role,
+			"scope":      "public",
+			"kind":       "link",
+			"can_revoke": true,
+		}
+		if permission.ExpirationTime != "" {
+			link["expires_at"] = permission.ExpirationTime
+		}
+		links = append(links, link)
+	}
+	return links, nil
+}
+
+func (f *Fs) mistyListAllPublicLinks(ctx context.Context) ([]map[string]any, error) {
+	query := "trashed=false and visibility='anyoneWithLink'"
+	pageToken := ""
+	links := []map[string]any{}
+	for {
+		var files *drive.FileList
+		err := f.pacer.Call(func() (bool, error) {
+			call := f.svc.Files.List().
+				Q(query).
+				Fields("nextPageToken, files(id,name,webViewLink)").
+				SupportsAllDrives(true).
+				IncludeItemsFromAllDrives(true).
+				PageSize(1000).
+				Context(ctx)
+			if pageToken != "" {
+				call = call.PageToken(pageToken)
+			}
+			var err error
+			files, err = call.Do()
+			return f.shouldRetry(ctx, err)
+		})
+		if err != nil {
+			return nil, err
+		}
+		for _, file := range files.Files {
+			if file == nil || file.Id == "" {
+				continue
+			}
+			fileLinks, err := f.mistyListPublicLinks(ctx, file.Id, file.Name)
+			if err != nil {
+				return nil, err
+			}
+			for _, link := range fileLinks {
+				if file.WebViewLink != "" {
+					link["url"] = file.WebViewLink
+				}
+				links = append(links, link)
+			}
+		}
+		if files.NextPageToken == "" {
+			return links, nil
+		}
+		pageToken = files.NextPageToken
+	}
+}
