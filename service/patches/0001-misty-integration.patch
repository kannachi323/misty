+func (f *Fs) mistyPublicLinksCommand(ctx context.Context, arg []string, opt map[string]string) (any, error) {
+	action := strings.TrimSpace(opt["action"])
+	if action == "" {
+		action = "list"
+	}
+	remote := strings.TrimSpace(opt["remote"])
+	if remote == "" && len(arg) > 0 {
+		remote = arg[0]
+	}
+	if remote == "" && action != "list" {
+		return nil, errors.New("remote path is required")
+	}
+	id := strings.TrimSpace(opt["target_id"])
+	if id == "" && remote != "" {
+		info, _, err := f.readMetaDataForPath(ctx, f.rootPath(remote))
+		if err != nil {
+			return nil, err
+		}
+		id = info.GetID()
+	}
+	switch action {
+	case "list":
+		if remote == "" {
+			links, err := f.mistyListAllPublicLinks(ctx)
+			if err != nil {
+				return nil, err
+			}
+			return map[string]any{"supported": true, "provider": "onedrive", "links": links}, nil
+		}
+		links, err := f.mistyListPublicLinks(ctx, id, remote)
+		if err != nil {
+			return nil, err
+		}
+		return map[string]any{"supported": true, "provider": "onedrive", "links": links}, nil
+	case "create":
+		opts := f.newOptsCall(id, "POST", "/createLink")
+		share := api.CreateShareLinkRequest{
+			Type:     f.opt.LinkType,
+			Scope:    f.opt.LinkScope,
+			Password: f.opt.LinkPassword,
+		}
+		var resp *http.Response
+		var created api.CreateShareLinkResponse
+		err := f.pacer.Call(func() (bool, error) {
+			var callErr error
+			resp, callErr = f.srv.CallJSON(ctx, &opts, &share, &created)
+			return shouldRetry(ctx, resp, callErr)
+		})
+		if err != nil {
+			return nil, err
+		}
+		role := strings.Join(created.Roles, ",")
+		return map[string]any{
+			"supported": true,
+			"provider":  "onedrive",
+			"link": map[string]any{
+				"id":         created.ID,
+				"url":        created.Link.WebURL,
+				"provider":   "onedrive",
+				"target_id":  id,
+				"path":       "/" + strings.TrimPrefix(remote, "/"),
+				"role":       role,
+				"scope":      created.Link.Scope,
+				"kind":       created.Link.Type,
+				"can_revoke": true,
+			},
+			"message": "Public link created.",
+		}, nil
+	case "revoke":
+		permissionID := strings.TrimSpace(opt["id"])
+		if permissionID == "" && len(arg) > 1 {
+			permissionID = arg[1]
+		}
+		if permissionID == "" {
+			return nil, errors.New("permission id is required")
+		}
+		if id == "" {
+			return nil, errors.New("target id is required")
+		}
+		opts := f.newOptsCall(id, "DELETE", "/permissions/"+permissionID)
+		opts.NoResponse = true
+		var resp *http.Response
+		err := f.pacer.Call(func() (bool, error) {
+			var callErr error
+			resp, callErr = f.srv.CallJSON(ctx, &opts, nil, nil)
+			return shouldRetry(ctx, resp, callErr)
+		})
+		if err != nil {
+			return nil, err
+		}
+		return map[string]any{"supported": true, "provider": "onedrive", "message": "Public link revoked."}, nil
+	default:
+		return nil, fmt.Errorf("unknown public link action %q", action)
+	}
+}
+
+func (f *Fs) mistyListPublicLinks(ctx context.Context, id, remote string) ([]map[string]any, error) {
+	permissions, _, err := f.getPermissions(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	links := make([]map[string]any, 0, len(permissions))
+	for _, permission := range permissions {
+		if permission == nil || permission.ID == "" || permission.Link == nil || permission.Link.WebURL == "" {
+			continue
+		}
+		roles := make([]string, 0, len(permission.Roles))
+		for _, role := range permission.Roles {
+			roles = append(roles, string(role))
+		}
+		role := ""
+		if len(roles) > 0 {
+			role = strings.Join(roles, ",")
+		}
+		links = append(links, map[string]any{
+			"id":         permission.ID,
+			"url":        permission.Link.WebURL,
+			"provider":   "onedrive",
+			"target_id":  id,
+			"path":       "/" + strings.TrimPrefix(remote, "/"),
+			"role":       role,
+			"scope":      string(permission.Link.Scope),
+			"kind":       string(permission.Link.Type),
+			"can_revoke": true,
+		})
+	}
+	return links, nil
+}
+
+func (f *Fs) mistyListAllPublicLinks(ctx context.Context) ([]map[string]any, error) {
+	links := []map[string]any{}
+	err := walk.ListR(ctx, f, "", true, -1, walk.ListAll, func(entries fs.DirEntries) error {
+		for _, entry := range entries {
+			id := ""
+			if ider, ok := entry.(fs.IDer); ok {
+				id = ider.ID()
+			}
+			if id == "" {
+				continue
+			}
+			itemLinks, err := f.mistyListPublicLinks(ctx, id, entry.Remote())
+			if err != nil {
+				return err
+			}
+			links = append(links, itemLinks...)
+		}
+		return nil
+	})
+	return links, err
+}
