+func (f *Fs) mistyPublicLinksCommand(ctx context.Context, arg []string, opt map[string]string) (any, error) {
+	action := strings.TrimSpace(opt["action"])
+	if action == "" {
+		action = "list"
+	}
+	remote := strings.TrimSpace(opt["remote"])
+	if remote == "" && len(arg) > 0 {
+		remote = arg[0]
+	}
+	if remote == "" && action != "list" {
+		return nil, errors.New("remote path is required")
+	}
+	switch action {
+	case "list":
+		links, err := f.mistyListPublicLinks(ctx, remote)
+		if err != nil {
+			return nil, err
+		}
+		return map[string]any{"supported": true, "provider": "dropbox", "links": links}, nil
+	case "create":
+		url, err := f.PublicLink(ctx, remote, fs.DurationOff, false)
+		if err != nil {
+			return nil, err
+		}
+		return map[string]any{
+			"supported": true,
+			"provider":  "dropbox",
+			"link": map[string]any{
+				"id":         url,
+				"url":        url,
+				"provider":   "dropbox",
+				"path":       "/" + strings.TrimPrefix(remote, "/"),
+				"role":       "viewer",
+				"scope":      "public",
+				"kind":       "link",
+				"can_revoke": true,
+			},
+			"message": "Public link created.",
+		}, nil
+	case "revoke":
+		linkID := strings.TrimSpace(opt["id"])
+		if linkID == "" && len(arg) > 1 {
+			linkID = arg[1]
+		}
+		if linkID == "" {
+			return nil, errors.New("shared link url is required")
+		}
+		err := f.pacer.Call(func() (bool, error) {
+			err := f.sharing.RevokeSharedLink(&sharing.RevokeSharedLinkArg{Url: linkID})
+			return shouldRetry(ctx, err)
+		})
+		if err != nil {
+			return nil, err
+		}
+		return map[string]any{"supported": true, "provider": "dropbox", "message": "Public link revoked."}, nil
+	default:
+		return nil, fmt.Errorf("unknown public link action %q", action)
+	}
+}
+
+func (f *Fs) mistyListPublicLinks(ctx context.Context, remote string) ([]map[string]any, error) {
+	arg := sharing.ListSharedLinksArg{}
+	if remote != "" {
+		absPath := f.opt.Enc.FromStandardPath(path.Join(f.slashRoot, remote))
+		arg.Path = absPath
+		arg.DirectOnly = true
+	}
+	links := []map[string]any{}
+	for {
+		var result *sharing.ListSharedLinksResult
+		var err error
+		err = f.pacer.Call(func() (bool, error) {
+			result, err = f.sharing.ListSharedLinks(&arg)
+			return shouldRetry(ctx, err)
+		})
+		if err != nil {
+			return nil, err
+		}
+		for _, metadata := range result.Links {
+			if link := f.mistyDropboxLinkRecord(remote, metadata); link != nil {
+				links = append(links, link)
+			}
+		}
+		if !result.HasMore || result.Cursor == "" || remote != "" {
+			return links, nil
+		}
+		arg.Cursor = result.Cursor
+	}
+}
+
+func (f *Fs) mistyDropboxLinkRecord(remote string, metadata sharing.IsSharedLinkMetadata) map[string]any {
+	recordPath := "/" + strings.TrimPrefix(remote, "/")
+	link := map[string]any{
+		"provider":   "dropbox",
+		"path":       recordPath,
+		"role":       "viewer",
+		"scope":      "public",
+		"kind":       "link",
+		"can_revoke": true,
+	}
+	switch value := metadata.(type) {
+	case *sharing.FileLinkMetadata:
+		link["id"] = value.Url
+		link["url"] = value.Url
+		if remote == "" && value.PathLower != "" {
+			link["path"] = value.PathLower
+		}
+		if value.Expires != nil {
+			link["expires_at"] = value.Expires.Format(time.RFC3339)
+		}
+	case *sharing.FolderLinkMetadata:
+		link["id"] = value.Url
+		link["url"] = value.Url
+		if remote == "" && value.PathLower != "" {
+			link["path"] = value.PathLower
+		}
+		if value.Expires != nil {
+			link["expires_at"] = value.Expires.Format(time.RFC3339)
+		}
+	case *sharing.SharedLinkMetadata:
+		link["id"] = value.Url
+		link["url"] = value.Url
+		if remote == "" && value.PathLower != "" {
+			link["path"] = value.PathLower
+		}
+		if value.Expires != nil {
+			link["expires_at"] = value.Expires.Format(time.RFC3339)
+		}
+	default:
+		return nil
+	}
+	if link["url"] == "" {
+		return nil
+	}
+	return link
+}
