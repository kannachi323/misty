{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "misty-web-app",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": {
      "name": "misty-web-app-dev",
      "routes": [
        {
          "pattern": "dev-app.mistysys.com",
          "custom_domain": true
        }
      ]
    }
  }
}
