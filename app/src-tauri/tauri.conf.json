{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Misty",
  "version": "0.1.0",
  "identifier": "com.misty.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Misty",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 720,
        "backgroundThrottling": "disabled",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: asset: http://asset.localhost http://ipc.localhost http://localhost:* http://127.0.0.1:* http://10.0.2.2:* ws://localhost:* ws://127.0.0.1:* ws://10.0.2.2:* https://us.i.posthog.com https: wss:; frame-src 'self' asset: http://asset.localhost customprotocol: misty-extension: http://misty-extension.localhost http://localhost:* http://127.0.0.1:* https://localhost:* https://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data: https:; media-src 'self' blob: asset: http://asset.localhost http://127.0.0.1:*; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$AUDIO/**",
          "$HOME/.misty/.cache/**",
          "$HOME/.misty/mnt/**",
          "$HOME/.misty/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCACHE/**",
          "$TEMP/**",
          "/Volumes/**",
          "/media/**",
          "/mnt/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "fileAssociations": [
      {
        "ext": ["mf"],
        "name": "Misty Workflow",
        "description": "Misty automation and agent workflow",
        "role": "Editor",
        "mimeType": "application/vnd.misty.workflow+json",
        "exportedType": {
          "identifier": "com.misty.workflow",
          "conformsTo": ["public.json", "public.data"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["misty"]
      },
      "mobile": [
        {
          "scheme": ["misty"],
          "appLink": false
        }
      ]
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
