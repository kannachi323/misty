{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://misty.com/schemas/workflow/mf-v1.schema.json",
  "title": "Misty Workflow (.mf)",
  "description": "Portable automation and Agent workflow graph. Runtime credentials, enablement, bindings, runs, and approvals are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "revision", "profile", "name", "description", "nodes", "edges", "settings", "createdAt", "updatedAt"],
  "properties": {
    "format": { "const": "misty.workflow" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "revision": { "type": "integer", "minimum": 1 },
    "profile": { "enum": ["automation", "agent", "universal"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 20000 },
    "nodes": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/edge" }
    },
    "settings": { "type": "object" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "mode"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["automatic", "approval"] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "position", "config", "policy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "config": { "type": "object" },
        "policy": { "type": "array", "items": { "$ref": "#/$defs/policy" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}
