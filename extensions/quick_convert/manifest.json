{
  "schema_version": 3,
  "id": "quick_convert",
  "name": "Quick Convert",
  "version": "0.2.0",
  "description": "Convert selected image, audio, and video files with system FFmpeg.",
  "author": "Misty",
  "enabled": true,
  "platforms": ["web"],
  "runtime": {
    "type": "web",
    "entry": "web/index.html?plugin=quick_convert"
  },
  "launcher": {
    "views": ["Files"],
    "show_in_launcher": true,
    "requires_selected_file": true,
    "open_mode": "split"
  },
  "plugin": {
    "runtime": "web",
    "entry": "web/index.html?plugin=quick_convert"
  },
  "panels": [
    {
      "id": "quick-convert.panel",
      "title": "Quick Convert",
      "window_type": "panel",
      "default_width": 520,
      "default_height": 420,
      "entry": "web/index.html?plugin=quick_convert",
      "launcher": {
        "views": ["Files"]
      }
    }
  ]
}
