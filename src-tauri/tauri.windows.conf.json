{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Misty",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 720,
        "backgroundThrottling": "disabled",
        "backgroundColor": "#131313",
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
