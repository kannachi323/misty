{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Misty",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundThrottling": "disabled",
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "target/misty-service/host/misty_service.dll": "misty_service.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
