{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Misty",
  "version": "0.1.0",
  "identifier": "com.misty.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Misty",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "$VIDEO/**",
          "$AUDIO/**",
          "$HOME/.misty/.cache/**",
          "$HOME/.misty/mnt/**",
          "$HOME/.misty/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCACHE/**",
          "$TEMP/**",
          "/Volumes/**",
          "/media/**",
          "/mnt/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["misty"]
      },
      "mobile": [
        {
          "scheme": ["misty"],
          "appLink": false
        }
      ]
    }
  }
}
